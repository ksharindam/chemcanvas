#!/bin/bash

echo "<RCC>" > resources.qrc
echo "  <qresource>" >> resources.qrc

for f in icons/*; do
    echo "    <file>${f}</file>" >> resources.qrc
done

for f in hazard-symbols/*; do
    echo "    <file>${f}</file>" >> resources.qrc
done

echo "  </qresource>" >> resources.qrc
echo "</RCC>" >> resources.qrc

# requires qt6-base-dev-tools or qtbase5-dev-tools package
rcc -g python resources.qrc -o ../chemcanvas/resources_rc.py

if [ $? -eq 0 ]; then
    sed -i "s/^from PySide.*/try:\n    from PyQt6 import QtCore\nexcept:\n    from PyQt5 import QtCore/g" ../chemcanvas/resources_rc.py
    echo "Compiled Resources saved as ../chemcanvas/resources_rc.py"
else
    echo "Failed to compile resources"
fi

